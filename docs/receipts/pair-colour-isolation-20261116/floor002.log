Pi.evalAddMonoidHom.{u, v} {I : Type u} (f : I → Type v) [(i : I) → AddZeroClass (f i)] (i : I) : ((i : I) → f i) →+ f i
AddMonoidHom.fst.{u_3, u_4} (M : Type u_3) (N : Type u_4) [AddZeroClass M] [AddZeroClass N] : M × N →+ M
AddMonoidHom.snd.{u_3, u_4} (M : Type u_3) (N : Type u_4) [AddZeroClass M] [AddZeroClass N] : M × N →+ N
AddMonoidHom.prod.{u_3, u_4, u_5} {M : Type u_3} {N : Type u_4} {P : Type u_5} [AddZeroClass M] [AddZeroClass N]
