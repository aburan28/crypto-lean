/-
Formal parts of the math-st open-problem closures (isogeny-labs/crypto,
`research/math_st_open_problems_20261119/`):

* A3 (math-st P5.2/Q025), claim (A), integer core: if `α` has norm `d`, then
  `N(α^m - 1) ≤ (√d^m + 1)^2`, so any `r ∣ N(α^m - 1) ≠ 0` has
  `r ≤ (√d^m + 1)^2`. The bridge `End(E) ↪ order`, `deg = N`, is not in
  Mathlib and stays a hypothesis of the consumer (`deg ω = normSq α`).
* A3, claim (B): with a character `χ` whose kernel is exactly the subgroup
  generated by the eigenvalue `λ`, `t` lies in the `λ`-orbit of `s` iff
  `χ t = χ s`. A canonical such `χ` is the quotient map.
* A1 (math-st P2.3), the envelope `R(n,d) ≥ L(n,d)`: over `ZMod n`, `n` prime,
  `X^d - 1` has `gcd(n-1, d)` roots and `X^d - X` has `1 + gcd(n-1, d-1)`.

Claim (C) of A3 (the generic-group bound) is not formalized here; it needs a
generic-group-model framework that this library does not have.
-/
import Mathlib

namespace CryptoLean.MathSt

open Complex

/-! ## A3 (A): orbit length of a non-automorphism endomorphism -/

/-- Triangle inequality in `ℂ`: `normSq (α^m - 1) ≤ (‖α‖^m + 1)^2`, with
`‖α‖ = √(normSq α)`. -/
theorem normSq_pow_sub_one_le (α : ℂ) (m : ℕ) :
    normSq (α ^ m - 1) ≤ (Real.sqrt (normSq α) ^ m + 1) ^ 2 := by
  have h1 : ‖α ^ m - 1‖ ≤ ‖α‖ ^ m + 1 := by
    calc ‖α ^ m - 1‖ ≤ ‖α ^ m‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
      _ = ‖α‖ ^ m + 1 := by rw [norm_pow, norm_one]
  have hn : ‖α‖ = Real.sqrt (normSq α) := by
    rw [Complex.normSq_eq_norm_sq, Real.sqrt_sq (norm_nonneg α)]
  rw [Complex.normSq_eq_norm_sq, ← hn]
  exact pow_le_pow_left₀ (norm_nonneg _) h1 2

/-- A3 (A), integer form. If `α` has norm `d` (the degree of the endomorphism
`ω`), and the prime-order subgroup order `r` divides the nonzero norm
`N = normSq (α^m - 1)` (the degree of `ω^m - 1`, which kills the subgroup),
then `r ≤ (√d^m + 1)^2`. -/
theorem orbit_divisor_le (α : ℂ) (d : ℝ) (hd : normSq α = d) (m r N : ℕ)
    (hN : (N : ℝ) = normSq (α ^ m - 1)) (hN0 : N ≠ 0) (hr : r ∣ N) :
    (r : ℝ) ≤ (Real.sqrt d ^ m + 1) ^ 2 := by
  have hle : r ≤ N := Nat.le_of_dvd (Nat.pos_of_ne_zero hN0) hr
  calc (r : ℝ) ≤ N := by exact_mod_cast hle
    _ = normSq (α ^ m - 1) := hN
    _ ≤ (Real.sqrt (normSq α) ^ m + 1) ^ 2 := normSq_pow_sub_one_le α m
    _ = (Real.sqrt d ^ m + 1) ^ 2 := by rw [hd]

/-- `ω^m ≠ 1` when `deg ω = d ≥ 2`: `normSq (α^m) = d^m ≠ 1` for `m ≥ 1`, so
the norm `N` in `orbit_divisor_le` is nonzero. -/
theorem normSq_pow_sub_one_ne_zero (α : ℂ) (d : ℝ) (hd : normSq α = d) (hd2 : 2 ≤ d)
    (m : ℕ) (hm : 1 ≤ m) : normSq (α ^ m - 1) ≠ 0 := by
  intro h
  have h0 : α ^ m - 1 = 0 := Complex.normSq_eq_zero.mp h
  have h1 : α ^ m = 1 := sub_eq_zero.mp h0
  have : normSq (α ^ m) = d ^ m := by rw [map_pow, hd]
  rw [h1, map_one] at this
  have hgt : (1 : ℝ) < d ^ m := one_lt_pow₀ (by linarith) (by omega)
  linarith

/-! ## A3 (B): same orbit iff same residue character of the logarithm -/

/-- A3 (B). `G` plays `𝔽_r^*` (the logarithms), `λ` the eigenvalue of `ω` on
the subgroup. If `χ` has kernel exactly `⟨λ⟩`, then `t` is in the `λ`-orbit
of `s` iff `χ t = χ s`. -/
theorem same_orbit_iff_char_eq {G K : Type*} [CommGroup G] [Group K] (χ : G →* K)
    (lam : G) (hker : χ.ker = Subgroup.zpowers lam) (s t : G) :
    (∃ i : ℤ, t = lam ^ i * s) ↔ χ t = χ s := by
  constructor
  · rintro ⟨i, rfl⟩
    have hmem : lam ^ i ∈ χ.ker := by rw [hker]; exact Subgroup.zpow_mem_zpowers lam i
    rw [map_mul, MonoidHom.mem_ker.mp hmem, one_mul]
  · intro h
    have hmem : t * s⁻¹ ∈ χ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, h, mul_inv_cancel]
    rw [hker] at hmem
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp hmem
    exact ⟨i, by rw [hi, inv_mul_cancel_right]⟩

/-- The character in A3 (B) exists: the quotient map by `⟨λ⟩` has kernel
exactly `⟨λ⟩`. On a cyclic `G` its target is cyclic of order the index `k`. -/
theorem exists_char_ker_eq {G : Type*} [CommGroup G] (lam : G) :
    ∃ χ : G →* G ⧸ Subgroup.zpowers lam, χ.ker = Subgroup.zpowers lam :=
  ⟨QuotientGroup.mk' _, QuotientGroup.ker_mk' _⟩

/-! ## A1: the envelope `R(n,d) ≥ L(n,d)` -/

/-- In a finite cyclic group of order `c`, exactly `gcd(c, d)` elements
satisfy `u^d = 1`. (Mathlib's `IsCyclic.card_powMonoidHom_ker`, restated.) -/
theorem card_pow_eq_one_cyclic (G : Type*) [CommGroup G] [IsCyclic G] [Finite G] (d : ℕ) :
    Nat.card {u : G // u ^ d = 1} = (Nat.card G).gcd d := by
  rw [← IsCyclic.card_powMonoidHom_ker G d]
  rfl

variable {n : ℕ} [hn : Fact n.Prime]

/-- `X^d - 1` has `gcd(n-1, d)` roots in `𝔽_n` for `d ≥ 1`. -/
theorem card_roots_X_pow_sub_one (d : ℕ) (hd : 1 ≤ d) :
    Nat.card {x : ZMod n // x ^ d = 1} = (n - 1).gcd d := by
  have hcard : Nat.card (ZMod n)ˣ = n - 1 := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient, Nat.totient_prime hn.out]
  rw [← hcard, ← card_pow_eq_one_cyclic (ZMod n)ˣ d]
  refine Nat.card_congr
    { toFun := fun x => ⟨Units.mk0 x.1 (ne_zero_of_pow_eq_one x.2), Units.ext (by
          rw [Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one]; exact x.2)⟩
      invFun := fun u => ⟨u.1.1, by
          have h := congrArg Units.val u.2
          rwa [Units.val_pow_eq_pow_val, Units.val_one] at h⟩
      left_inv := fun x => Subtype.ext rfl
      right_inv := fun u => Subtype.ext (Units.ext rfl) }
where
  ne_zero_of_pow_eq_one {x : ZMod n} (h : x ^ d = 1) : x ≠ 0 := by
    intro h0
    rw [h0, zero_pow (by omega)] at h
    exact zero_ne_one h

/-- Zero plus the `k`-th roots of unity: the roots of `X^(k+1) - X`. -/
theorem card_pow_succ_eq_self (k : ℕ) (hk : 1 ≤ k) :
    Nat.card {x : ZMod n // x ^ (k + 1) = x} = 1 + Nat.card {x : ZMod n // x ^ k = 1} := by
  have hne : ∀ y : {x : ZMod n // x ^ k = 1}, y.1 ≠ 0 := fun y h0 => by
    have h := y.2; rw [h0, zero_pow (by omega)] at h; exact zero_ne_one h
  have e : {x : ZMod n // x ^ (k + 1) = x} ≃ Option {x : ZMod n // x ^ k = 1} :=
    { toFun := fun x => if h : x.1 = 0 then none else some ⟨x.1, by
          have hx := x.2
          rw [pow_succ] at hx
          exact mul_left_cancel₀ h (by rw [mul_one, mul_comm]; exact hx)⟩
      invFun := fun o => match o with
        | none => ⟨0, by rw [zero_pow (by omega)]⟩
        | some y => ⟨y.1, by rw [pow_succ, y.2, one_mul]⟩
      left_inv := fun x => by
        by_cases h : x.1 = 0
        · simp only [h, dite_true]; exact Subtype.ext h.symm
        · simp [h]
      right_inv := fun o => by
        rcases o with _ | y
        · simp
        · simp [hne y] }
  rw [Nat.card_congr e, Finite.card_option, add_comm]

/-- `X^d - X` has `1 + gcd(n-1, d-1)` roots in `𝔽_n` for `d ≥ 2`: zero and
the `(d-1)`-th roots of unity. -/
theorem card_roots_X_pow_sub_X (d : ℕ) (hd : 2 ≤ d) :
    Nat.card {x : ZMod n // x ^ d = x} = 1 + (n - 1).gcd (d - 1) := by
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  rw [card_pow_succ_eq_self k (by omega), Nat.add_sub_cancel,
    card_roots_X_pow_sub_one k (by omega)]

end CryptoLean.MathSt
