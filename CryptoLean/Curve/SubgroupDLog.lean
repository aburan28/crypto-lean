import CryptoLean.Group.GenericDLog
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Tactic.FinCases
import Mathlib.GroupTheory.OrderOfElement

/-!
# From a prime-order subgroup to an elliptic-curve query bound

For a point `P` of order `r`, the map `ZMod r → G` sending `x` to `x • P` is
an injective additive map. The equality observations and generic oracle on `G`
therefore reduce to the scalar model. The Hasse inequality and a cofactor bound
relate the resulting query bound to an interval for the size of the residue field.
-/

set_option autoImplicit false

namespace CryptoLean.ECDLP

open GenericDLog

section Group

variable {G : Type*} [AddCommGroup G] {r : ℕ}

private def multiples (P : G) (horder : addOrderOf P = r) : {f : ℤ →+ G // f r = 0} :=
  ⟨zmultiplesHom G P, by
    change (r : ℤ) • P = 0
    rw [natCast_zsmul, ← horder, addOrderOf_nsmul_eq_zero]⟩

/-- The scalar map into the subgroup generated by `P`. -/
def scalarToPoint (P : G) (horder : addOrderOf P = r) : ZMod r →+ G :=
  ZMod.lift r (multiples P horder)

theorem scalarToPoint_injective (P : G) (horder : addOrderOf P = r) :
    Function.Injective (scalarToPoint P horder) := by
  unfold scalarToPoint
  apply (ZMod.lift_injective r).mpr
  intro z hz
  change z • P = 0 at hz
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd z r).mpr
    (horder ▸ addOrderOf_dvd_iff_zsmul_eq_zero.mpr hz)

theorem scalarToPoint_natCast (P : G) (horder : addOrderOf P = r) (a : ℕ) :
    scalarToPoint P horder (a : ZMod r) = a • P := by
  rw [show (a : ZMod r) = ((a : ℤ) : ZMod r) by norm_cast, scalarToPoint, ZMod.lift_coe]
  exact natCast_zsmul P a

theorem scalarToPoint_eq_nsmul [NeZero r] (P : G) (horder : addOrderOf P = r) (a : ZMod r) :
    scalarToPoint P horder a = a.val • P := by
  calc
    scalarToPoint P horder a = scalarToPoint P horder (a.val : ZMod r) := by
      rw [ZMod.natCast_zmod_val]
    _ = _ := scalarToPoint_natCast P horder a.val

private theorem scalarToPoint_mul [NeZero r] (P : G) (horder : addOrderOf P = r) (a b : ZMod r) :
    scalarToPoint P horder (a * b) = a.val • scalarToPoint P horder b := by
  conv_lhs => rw [← ZMod.natCast_zmod_val a, ← nsmul_eq_mul]
  exact map_nsmul (scalarToPoint P horder) a.val b

def pointOracle (P : G) (samples : ℕ → ZMod r) : Oracle r G := fun n cmd table =>
  match cmd with
  | .linear i j a b => a.val • table i + b.val • table j
  | .sample => (samples n).val • P

theorem scalarToPoint_oracle [NeZero r] (P : G) (horder : addOrderOf P = r)
    (samples : ℕ → ZMod r) (n : ℕ) (cmd : Query r n) (table : Fin n → ZMod r) :
    scalarToPoint P horder (scalarOracle r samples n cmd table) =
      pointOracle P samples n cmd (scalarToPoint P horder ∘ table) := by
  cases cmd with
  | linear => simp [scalarOracle, pointOracle, scalarToPoint_mul]
  | sample => simp [scalarOracle, pointOracle, scalarToPoint_eq_nsmul]

private theorem startingTable_eq [NeZero r] (P : G) (horder : addOrderOf P = r) (x : ZMod r) :
    scalarToPoint P horder ∘ (eval x ∘ startingForms r) = ![0, P, x.val • P] := by
  have hone : scalarToPoint P horder 1 = P := by simpa using scalarToPoint_natCast P horder 1
  funext i
  fin_cases i <;> simp [startingForms, eval, Function.comp_def, hone, scalarToPoint_eq_nsmul]

variable [DecidableEq G] {View : ℕ → Type*} {q : ℕ}

/-- The algorithm started on the identity, the base point, and the challenge point. -/
def pointGuess (P : G) (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) (x : ZMod r) : ZMod r :=
  (run observe (pointOracle P samples) strategy ![0, P, x.val • P]).answer

/-- The number of actual oracle calls for this challenge, excluding the starting handles. -/
def pointQueryCount (P : G) (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) (x : ZMod r) : ℕ :=
  (run observe (pointOracle P samples) strategy ![0, P, x.val • P]).size - 3

variable [Fact r.Prime]

private theorem pointRun_eq_scalarRun (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) (x : ZMod r) :
    let pointRun := run observe (pointOracle P samples) strategy ![0, P, x.val • P]
    let scalarRun := run observe (scalarOracle r samples) strategy (eval x ∘ startingForms r)
    (pointRun.size, pointRun.answer) = (scalarRun.size, scalarRun.answer) := by
  let : NeZero r := ⟨(Fact.out : r.Prime).ne_zero⟩
  dsimp only
  rw [← startingTable_eq P horder x]
  exact run_size_answer_eq_of_injOn observe (scalarOracle r samples) (pointOracle P samples)
    (scalarToPoint P horder) (scalarToPoint_oracle P horder samples) strategy _
    (scalarToPoint_injective P horder).injOn

theorem pointGuess_eq_scalarGuess (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) (x : ZMod r) :
    pointGuess P observe samples strategy x = scalarGuess observe samples strategy x :=
  congrArg Prod.snd (pointRun_eq_scalarRun P horder observe samples strategy x)

theorem pointQueryCount_eq_scalarQueryCount (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) (x : ZMod r) :
    pointQueryCount P observe samples strategy x = scalarQueryCount observe samples strategy x :=
  congrArg (fun result => result.1 - 3) (pointRun_eq_scalarRun P horder observe samples strategy x)

noncomputable def pointSuccessProbability (P : G) (observe : ∀ n, Pattern n → View n)
    (samples : ℕ → ZMod r) (strategy : Strategy r View 3 q) : ℝ := by
  let : NeZero r := ⟨(Fact.out : r.Prime).ne_zero⟩
  exact ((Finset.univ.filter fun x => pointGuess P observe samples strategy x = x).card : ℝ) / r

theorem pointSuccessProbability_eq_scalar (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) :
    pointSuccessProbability P observe samples strategy = successProbability observe samples strategy := by
  unfold pointSuccessProbability successProbability successSecrets
  simp only [pointGuess_eq_scalarGuess P horder]

/-- The generic query bound for the discrete logarithm in an actual prime-order subgroup. -/
theorem pointSuccessProbability_le (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q) :
    pointSuccessProbability P observe samples strategy ≤ (successNumerator q : ℝ) / (2 * (r : ℝ)) := by
  rw [pointSuccessProbability_eq_scalar P horder]
  exact successProbability_le observe samples strategy

noncomputable def mixedPointSuccessProbability {Seed : Type*} [Fintype Seed] (P : G) (weights : Seed → ℝ)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q) : ℝ :=
  ∑ s, weights s * pointSuccessProbability P (observe s) (samples s) (strategy s)

theorem mixedPointSuccessProbability_eq_scalar {Seed : Type*} [Fintype Seed] (P : G)
    (horder : addOrderOf P = r) (weights : Seed → ℝ) (observe : Seed → ∀ n, Pattern n → View n)
    (samples : Seed → ℕ → ZMod r) (strategy : Seed → Strategy r View 3 q) :
    mixedPointSuccessProbability P weights observe samples strategy =
      mixedSuccessProbability weights observe samples strategy := by
  unfold mixedPointSuccessProbability mixedSuccessProbability
  simp only [pointSuccessProbability_eq_scalar P horder]

/-- The mean actual query count on independently sampled secrets and seeds. -/
noncomputable def mixedPointExpectedQueries {Seed : Type*} [Fintype Seed] (P : G) (weights : Seed → ℝ)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q) : ℝ :=
  ∑ s, weights s * expectedQueries (pointQueryCount P (observe s) (samples s) (strategy s))

theorem mixedPointExpectedQueries_eq_scalar {Seed : Type*} [Fintype Seed] (P : G)
    (horder : addOrderOf P = r) (weights : Seed → ℝ) (observe : Seed → ∀ n, Pattern n → View n)
    (samples : Seed → ℕ → ZMod r) (strategy : Seed → Strategy r View 3 q) :
    mixedPointExpectedQueries P weights observe samples strategy =
      mixedExpectedQueries weights observe samples strategy := by
  unfold mixedPointExpectedQueries mixedExpectedQueries expectedQueries
  simp only [pointQueryCount_eq_scalarQueryCount P horder]

/-- Every generic strategy has the same success probability in subgroups of the same prime order. -/
theorem mixedPointSuccessProbability_eq_of_same_order {G' : Type*} [AddCommGroup G'] [DecidableEq G']
    {Seed : Type*} [Fintype Seed] (P : G) (P' : G')
    (horder : addOrderOf P = r) (horder' : addOrderOf P' = r) (weights : Seed → ℝ)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q) :
    mixedPointSuccessProbability P weights observe samples strategy =
      mixedPointSuccessProbability P' weights observe samples strategy := by
  simp only [mixedPointSuccessProbability_eq_scalar P horder, mixedPointSuccessProbability_eq_scalar P' horder']

/-- A generic strategy preserves the mean of its adaptive stopping time at fixed subgroup order. -/
theorem mixedPointExpectedQueries_eq_of_same_order {G' : Type*} [AddCommGroup G'] [DecidableEq G']
    {Seed : Type*} [Fintype Seed] (P : G) (P' : G')
    (horder : addOrderOf P = r) (horder' : addOrderOf P' = r) (weights : Seed → ℝ)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q) :
    mixedPointExpectedQueries P weights observe samples strategy =
      mixedPointExpectedQueries P' weights observe samples strategy := by
  simp only [mixedPointExpectedQueries_eq_scalar P horder, mixedPointExpectedQueries_eq_scalar P' horder']

/-- A query budget suffices if some randomized strategy attains the required success probability. -/
def genericSuccessAtLeast {Seed : Type*} [Fintype Seed] (P : G) (budget : ℕ) (threshold : ℝ) : Prop :=
  ∃ (weights : Seed → ℝ) (observe : Seed → ∀ n, Pattern n → View n)
    (samples : Seed → ℕ → ZMod r) (strategy : Seed → Strategy r View 3 budget),
    (∀ s, 0 ≤ weights s) ∧ (∑ s, weights s) = 1 ∧
      threshold ≤ mixedPointSuccessProbability P weights observe samples strategy

/-- At fixed prime subgroup order, every query budget and success threshold agree. -/
theorem genericSuccessAtLeast_iff_of_same_order {G' : Type*} [AddCommGroup G'] [DecidableEq G']
    {Seed : Type*} [Fintype Seed] (P : G) (P' : G') (horder : addOrderOf P = r)
    (horder' : addOrderOf P' = r) (budget : ℕ) (threshold : ℝ) :
    genericSuccessAtLeast (r := r) (View := View) (Seed := Seed) P budget threshold ↔
      genericSuccessAtLeast (r := r) (View := View) (Seed := Seed) P' budget threshold := by
  unfold genericSuccessAtLeast
  simp only [mixedPointSuccessProbability_eq_of_same_order P P' horder horder']

theorem mixedPointSuccessProbability_le {Seed : Type*} [Fintype Seed] (P : G) (horder : addOrderOf P = r)
    (weights : Seed → ℝ) (hnonneg : ∀ s, 0 ≤ weights s) (hnorm : ∑ s, weights s = 1)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q) :
    mixedPointSuccessProbability P weights observe samples strategy ≤
      (successNumerator q : ℝ) / (2 * (r : ℝ)) := by
  rw [mixedPointSuccessProbability_eq_scalar P horder]
  exact mixedSuccessProbability_le weights hnonneg hnorm observe samples strategy

theorem order_le_of_half_success (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q)
    (hsuccess : (1 : ℝ) / 2 ≤ pointSuccessProbability P observe samples strategy) : r ≤ successNumerator q :=
  order_le_successNumerator_of_half (Fact.out : r.Prime).pos
    (pointSuccessProbability_le P horder observe samples strategy) hsuccess

theorem sqrt_order_sub_two_le_of_half_success (P : G) (horder : addOrderOf P = r)
    (observe : ∀ n, Pattern n → View n) (samples : ℕ → ZMod r)
    (strategy : Strategy r View 3 q)
    (hsuccess : (1 : ℝ) / 2 ≤ pointSuccessProbability P observe samples strategy) :
    Real.sqrt ((r : ℝ) - 2) ≤ (q : ℝ) + 3 :=
  sqrt_order_sub_two_le_budget (order_le_of_half_success P horder observe samples strategy hsuccess)

end Group

noncomputable def cofactor {G : Type*} [AddCommGroup G] (P : G) : ℕ := Nat.card G / addOrderOf P

theorem cofactor_mul_order {G : Type*} [AddCommGroup G] (P : G) :
    cofactor P * addOrderOf P = Nat.card G :=
  Nat.div_mul_cancel (addOrderOf_dvd_natCard P)

/-- The Hasse inequality for a point count over `𝔽_p`. -/
def SatisfiesHasse (p pointCount : ℕ) : Prop :=
  |(pointCount : ℝ) - ((p : ℝ) + 1)| ≤ 2 * Real.sqrt p

/-- Transfer the Hasse interval to a bracket for the residue characteristic. -/
theorem pointCount_in_field_interval {lower upper p pointCount : ℕ}
    (hlower : 1 ≤ lower) (hleft : lower ≤ p) (hright : p ≤ upper)
    (hHasse : SatisfiesHasse p pointCount) :
    (Real.sqrt lower - 1) ^ 2 ≤ (pointCount : ℝ) ∧ (pointCount : ℝ) ≤ (Real.sqrt upper + 1) ^ 2 := by
  have hsl := Real.sqrt_le_sqrt (show (lower : ℝ) ≤ (p : ℝ) by exact_mod_cast hleft)
  have hsu := Real.sqrt_le_sqrt (show (p : ℝ) ≤ (upper : ℝ) by exact_mod_cast hright)
  have hs1 : 1 ≤ Real.sqrt lower := by
    simpa using Real.sqrt_le_sqrt (show (1 : ℝ) ≤ (lower : ℝ) by exact_mod_cast hlower)
  have hs0 := Real.sqrt_nonneg (p : ℝ)
  have hs2 := Real.sq_sqrt (show 0 ≤ (p : ℝ) by positivity)
  obtain ⟨hmin, hmax⟩ := abs_le.mp hHasse
  constructor
  · calc
      (Real.sqrt lower - 1) ^ 2 ≤ (Real.sqrt p - 1) ^ 2 :=
        pow_le_pow_left₀ (sub_nonneg.mpr hs1) (sub_le_sub_right hsl 1) 2
      _ ≤ (pointCount : ℝ) := by nlinarith
  · calc
      (pointCount : ℝ) ≤ (Real.sqrt p + 1) ^ 2 := by nlinarith
      _ ≤ (Real.sqrt upper + 1) ^ 2 :=
        pow_le_pow_left₀ (by positivity) (add_le_add hsu le_rfl) 2

section EllipticCurve

variable {p r q : ℕ} [Fact p.Prime] [Fact r.Prime] {View : ℕ → Type*}
variable (W : WeierstrassCurve (ZMod p))

/-- Apply the randomized generic bound to the points of a nonsingular model over `𝔽_p`
when its Hasse inequality and an upper bound for the cofactor are supplied. -/
theorem half_success_in_field_interval {lower upper H : ℕ} [W.IsElliptic]
    (hlower : 1 ≤ lower) (hleft : lower ≤ p) (hright : p ≤ upper)
    (hHasse : SatisfiesHasse p (Nat.card W.toAffine.Point))
    (P : W.toAffine.Point) (horder : addOrderOf P = r) (hcofactor : cofactor P ≤ H)
    {Seed : Type*} [Fintype Seed] (weights : Seed → ℝ)
    (hnonneg : ∀ s, 0 ≤ weights s) (hnorm : ∑ s, weights s = 1)
    (observe : Seed → ∀ n, Pattern n → View n) (samples : Seed → ℕ → ZMod r)
    (strategy : Seed → Strategy r View 3 q)
    (hsuccess : (1 : ℝ) / 2 ≤ mixedPointSuccessProbability P weights observe samples strategy) :
    (Real.sqrt lower - 1) ^ 2 ≤ (H : ℝ) * (successNumerator q : ℝ) := by
  have hr := order_le_successNumerator_of_half (Fact.out : r.Prime).pos
    (mixedPointSuccessProbability_le P horder weights hnonneg hnorm observe samples strategy) hsuccess
  have hcard : (Nat.card W.toAffine.Point : ℝ) = (cofactor P : ℝ) * (r : ℝ) := by
    exact_mod_cast (horder ▸ cofactor_mul_order P).symm
  calc
    (Real.sqrt lower - 1) ^ 2 ≤ (Nat.card W.toAffine.Point : ℝ) :=
      (pointCount_in_field_interval hlower hleft hright hHasse).1
    _ = (cofactor P : ℝ) * (r : ℝ) := hcard
    _ ≤ (H : ℝ) * (successNumerator q : ℝ) := by
      exact_mod_cast Nat.mul_le_mul hcofactor hr

end EllipticCurve

/-- A square-root query bound using the lower endpoint of the field-size bracket. -/
theorem sqrt_field_lower_bound_le_budget {lower H q : ℕ} (hH : 0 < H)
    (hwork : (Real.sqrt lower - 1) ^ 2 ≤ (H : ℝ) * (successNumerator q : ℝ)) :
    Real.sqrt ((Real.sqrt lower - 1) ^ 2 / (H : ℝ) - 2) ≤ (q : ℝ) + 3 := by
  have hdiv : (Real.sqrt lower - 1) ^ 2 / (H : ℝ) ≤ (successNumerator q : ℝ) :=
    (div_le_iff₀ (by exact_mod_cast hH)).mpr (by simpa [mul_comm] using hwork)
  have hu : (successNumerator q : ℝ) ≤ ((q : ℝ) + 3) ^ 2 + 2 := by
    exact_mod_cast successNumerator_le_sq_add_two q
  apply (Real.sqrt_le_left (by positivity)).mpr
  linarith

/-- Equal point counts give matching prime-order subgroups with equal attainable
generic success at every query budget. -/
theorem generic_hardness_of_equal_point_counts {F : Type*} [Field F] [Finite F] [DecidableEq F]
    (W₀ W₁ : WeierstrassCurve F) [W₀.IsElliptic] [W₁.IsElliptic]
    (hcount : Nat.card W₀.toAffine.Point = Nat.card W₁.toAffine.Point)
    {r : ℕ} [Fact r.Prime] (P₀ : W₀.toAffine.Point) (hP₀ : addOrderOf P₀ = r)
    {View : ℕ → Type*} {Seed : Type*} [Fintype Seed] :
    ∃ P₁ : W₁.toAffine.Point, addOrderOf P₁ = r ∧ ∀ budget threshold,
      genericSuccessAtLeast (r := r) (View := View) (Seed := Seed) P₀ budget threshold ↔
        genericSuccessAtLeast (r := r) (View := View) (Seed := Seed) P₁ budget threshold := by
  have hdiv : r ∣ Nat.card W₁.toAffine.Point := by
    rw [← hcount, ← hP₀]
    exact addOrderOf_dvd_natCard P₀
  let : Finite W₁.toAffine.Point := Finite.of_equiv
    (Option {xy : F × F // W₁.toAffine.Nonsingular xy.1 xy.2})
    W₁.toAffine.nonsingularPointEquiv.symm
  obtain ⟨P₁, hP₁⟩ := exists_prime_addOrderOf_dvd_card' r hdiv
  exact ⟨P₁, hP₁, genericSuccessAtLeast_iff_of_same_order P₀ P₁ hP₀ hP₁⟩

/-- Equal point counts give matching subgroups with the same success and mean query count for every strategy. -/
theorem generic_success_and_expectedQueries_of_equal_point_counts {F : Type*} [Field F] [Finite F] [DecidableEq F]
    (W₀ W₁ : WeierstrassCurve F) [W₀.IsElliptic] [W₁.IsElliptic]
    (hcount : Nat.card W₀.toAffine.Point = Nat.card W₁.toAffine.Point)
    {r : ℕ} [Fact r.Prime] (P₀ : W₀.toAffine.Point) (hP₀ : addOrderOf P₀ = r)
    {View : ℕ → Type*} {Seed : Type*} [Fintype Seed] :
    ∃ P₁ : W₁.toAffine.Point, addOrderOf P₁ = r ∧
      ∀ {q : ℕ} (weights : Seed → ℝ) (observe : Seed → ∀ n, Pattern n → View n)
        (samples : Seed → ℕ → ZMod r) (strategy : Seed → Strategy r View 3 q),
        (mixedPointSuccessProbability P₀ weights observe samples strategy,
          mixedPointExpectedQueries P₀ weights observe samples strategy) =
        (mixedPointSuccessProbability P₁ weights observe samples strategy,
          mixedPointExpectedQueries P₁ weights observe samples strategy) := by
  obtain ⟨P₁, hP₁, _⟩ :=
    generic_hardness_of_equal_point_counts (View := View) (Seed := Seed) W₀ W₁ hcount P₀ hP₀
  refine ⟨P₁, hP₁, ?_⟩
  intro q weights observe samples strategy
  exact Prod.ext (mixedPointSuccessProbability_eq_of_same_order P₀ P₁ hP₀ hP₁ weights observe samples strategy)
    (mixedPointExpectedQueries_eq_of_same_order P₀ P₁ hP₀ hP₁ weights observe samples strategy)

end CryptoLean.ECDLP
